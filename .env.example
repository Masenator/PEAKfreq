# ── Commerce ────────────────────────────────────────────────
# Stripe secret key. Without it, checkout runs in demo mode.
STRIPE_SECRET_KEY=sk_test_xxx
# Public site URL, e.g. https://peakfreq.com. Used for SEO and Stripe redirects.
# Optional on Vercel: falls back to the production domain automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Operations console (/ops) ──────────────────────────────
# Password for the catalog & margin console. If unset, /ops is
# available in development only and returns 404 in production.
OPS_PASSWORD=change-me

# ── Optional ───────────────────────────────────────────────
# Enable Stripe Tax on checkout sessions.
STRIPE_AUTOMATIC_TAX=false
# Forward newsletter sign-ups to your ESP / automation webhook.
NEWSLETTER_WEBHOOK_URL=
